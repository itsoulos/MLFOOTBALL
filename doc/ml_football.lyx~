\begin_layout Subsection
Feature Engineering and Mathematical Formulation
\end_layout

\begin_layout Standard
To capture the dynamic interaction between offensive and defensive capacities,
 the raw data was transformed into formal performance metrics.
 Let 
\begin_inset Formula $AvgH_{s}$
\end_inset

 and 
\begin_inset Formula $AvgH_{c}$
\end_inset

 denote the average goals scored and conceded by the home team,
 and 
\begin_inset Formula $AvgA_{s},AvgA_{c}$
\end_inset

 the corresponding values for the away team.
 A smoothing constant 
\begin_inset Formula $\epsilon=0.01$
\end_inset

 was applied to prevent division by zero.
\end_layout

\begin_layout Description
AttackVsDefense:
 Represents the home team's offensive efficiency relative to the away team's defensive record:
\begin_inset Formula 
\begin{equation}
\mbox{AttackVsDefense}=\frac{AvgH_{s}}{AvgA_{c}+\epsilon}\label{eq:attack_vs_defense}
\end{equation}

\end_inset


\end_layout

\begin_layout Description
DefenseVsAttack:
 Quantifies the home team's defensive capability against the away team's scoring force:
\begin_inset Formula 
\begin{equation}
\mbox{DefenseVsAttack}=\frac{AvgH_{c}}{AvgA_{s}+\epsilon}\label{eq:defensevsattack}
\end{equation}

\end_inset


\end_layout

\begin_layout Description
TotalScoringPotential:
 Modeled as the numerical difference between home and away scoring capacities,
 identifying the relative offensive edge:
\begin_inset Formula 
\begin{equation}
\mbox{TotalScoringPotential}=AvgH_{s}-AvgA_{s}\label{eq:totalscoringpotential}
\end{equation}

\end_inset


\end_layout

\begin_layout Description
TotalDefensiveWeakness:
 Assesses the relative vulnerability of the home defense compared to the away defense as a ratio:
\begin_inset Formula 
\begin{equation}
\mbox{TotalDefensiveWeakness}=\frac{AvgH_{c}}{AvgA_{c}+\epsilon}\label{eq:totaldefensiveweakness}
\end{equation}

\end_inset


\end_layout

\begin_layout Description

\shape italic
HomeCleanSheetRatio
\shape default
 (HCSR) and 
\series bold
\shape italic
AwayFTSRatio
\series default
\shape default
 (AFTS) capture probabilistic historical frequencies:
\begin_inset Formula 
\begin{equation}
HCSR=\frac{\sum^{N}_{i=1}\mathbb{I}(G_{H,c}=0)}{N},\quad AFTS=\frac{\sum^{N}_{j=1}\mathbb{I}(G_{A,s}=0)}{N}\label{eq:HCSR}
\end{equation}

\end_inset


\end_layout

